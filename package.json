{
  "name": "enpal-extension",
  "version": "2.0.0-playwright-spike.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/project-control/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:playwright:unit": "node --test tests/unit/playwright-chatgpt-page.test.js",
    "test:live": "node -e \"console.log('Run tests/live/enpal-v1-e2e-checklist.md in the configured production-like Chrome profile')\"",
    "pw:install": "npx playwright install chromium",
    "pw:smoke:start": "node playwright/smoke-start.js",
    "test:playwright:browser": "node --test tests/playwright/chatgpt-page.browser.test.js tests/playwright/browser-session.browser.test.js tests/playwright/workflow-start.browser.test.js",
    "test:playwright": "npm run test:playwright:unit && npm run test:playwright:browser",
    "pw:smoke:win": "powershell -NoProfile -ExecutionPolicy Bypass -File playwright/run-smoke-windows.ps1"
  },
  "dependencies": {
    "playwright": "1.63.0"
  }
}\n