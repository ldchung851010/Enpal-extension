{
  "manifest_version": 3,
  "name": "EnPal",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "storage",
    "identity",
    "scripting",
    "sidePanel",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://sheets.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "75024264025-jfk5jl6gip980b1fubg5jvmsnsdbqcf5.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "EnPal"
  }
}
